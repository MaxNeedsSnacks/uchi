#!/bin/sh
[ -n "${__ENVD_SOURCED:-}" ] && return
export __ENVD_SOURCED=1

# export xdg vars first
{{- range $k, $v := .env.xdg }}
export {{ $k }}="{{ $v }}"
{{- end }}

# double loop over any other data under the `env` map
# grouped by env.python, env.node, etc.
# ("paths" is reserved: NN_-keyed PATH entries, rendered below, never exported)
{{- range $group, $vars := .env }}
{{- if and (ne $group "xdg") (ne $group "paths") }}
# group env.{{$group}}
{{range $k, $v := $vars -}}
export {{ $k }}="{{ $v }}"
{{ end }}
{{- end -}}
{{- end }}
# PATH additions, sorted by NN_ prefix; leftmost = highest priority
export PATH="{{ range $k, $v := .env.paths }}{{ $v }}:{{ end }}$PATH"
