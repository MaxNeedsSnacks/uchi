bind \ch backward-kill-word     # ctrl + bksp
bind \e\[3\;5~ kill-word        # ctrl + del (or: fn + bksp on mac)
bind \e\[3\;2~ kill-line        # shift + del (or: fn + bksp on mac)
bind \eOM insert-line-under     # New line with shift + enter
bind \cz 'fg'                   # go back to foreground with ctrl + z
