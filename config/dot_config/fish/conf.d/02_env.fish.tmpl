# export xdg vars first
{{- range $k, $v := .env.xdg }}
set -gx {{ $k }} "{{ $v }}"
{{- end }}

# double loop over any other data under the `env` map
# grouped by env.python, env.node, etc.
# ("paths" is reserved: NN_-keyed PATH entries, rendered below, never exported)
{{- range $group, $vars := .env }}
{{- if and (ne $group "xdg") (ne $group "paths") }}
# group env.{{$group}}
{{range $k, $v := $vars -}}
set -gx {{ $k }} "{{ $v }}"
{{ end }}
{{- end -}}
{{- end }}

# PATH additions in one call so argument order (NN_ sort) is preserved
fish_add_path --global {{- range $k, $v := .env.paths }} "{{ $v }}"{{ end }}
