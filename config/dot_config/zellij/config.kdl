theme "sternwart"

default_layout "compact"
default_mode "locked"

ui {
    pane_frames {
        rounded_corners true
    }
}

themes {
    sternwart {
        fg "#cdd6f4" // tab indicator
        green "#fab387" // swapped with orange because it's the main frame colour
        magenta "#f38ba8" // keybind indicator
        orange "#a6e3a1" // text accent
        cyan "#89dceb" // description, another text accent
        black "#181825" // probably used somewhere idk

        bg "#585b70" // Surface2
        //fg "#cdd6f4"
        red "#f38ba8"
        //green "#a6e3a1"
        blue "#89b4fa"
        yellow "#f9e2af"
        //magenta "#f5c2e7" // Pink
        //orange "#fab387" // Peach
        //cyan "#89dceb" // Sky
        //black "#181825" // Mantle
        white "#cdd6f4"
    }
}

plugins {
    compact-bar location="https://github.com/dj95/zjstatus/releases/download/v0.18.1/zjstatus.wasm" {
        color_rosewater "#f5e0dc"
        color_flamingo "#f2cdcd"
        color_pink "#f5c2e7"
        color_mauve "#cba6f7"
        color_red "#f38ba8"
        color_maroon "#eba0ac"
        color_peach "#fab387"
        color_yellow "#f9e2af"
        color_green "#a6e3a1"
        color_teal "#94e2d5"
        color_sky "#89dceb"
        color_sapphire "#74c7ec"
        color_blue "#89b4fa"
        color_lavender "#b4befe"
        color_text "#cdd6f4"
        color_subtext1 "#bac2de"
        color_subtext0 "#a6adc8"
        color_overlay2 "#9399b2"
        color_overlay1 "#7f849c"
        color_overlay0 "#6c7086"
        color_surface2 "#585b70"
        color_surface1 "#45475a"
        color_surface0 "#313244"
        color_base "#1e1e2e"
        color_mantle "#181825"
        color_crust "#11111b"

        format_left   "#[bg=none,fg=$sapphire]#[bg=$sapphire,fg=$crust,bold] {session} #[bg=none]{mode}#[bg=none] {tabs}"
        format_center "{notifications}"
        format_right  "#[bg=none,fg=$maroon]#[bg=$maroon,fg=$crust]󰃭 #[bg=$surface0,fg=$maroon,bold] {datetime}#[bg=none,fg=$surface0]"
        format_space  "#[bg=none]"
        format_hide_on_overlength "true"
        format_precedence "lrc"

        border_enabled  "false"
        border_char     "─"
        border_format   "#[bg=none]{char}"
        border_position "top"

        hide_frame_for_single_pane "false"

        mode_locked        "#[fg=$sapphire,bold,bg=$red] #[bg=$red,fg=$crust,bold]Insert#[bg=none,fg=$red]"
        mode_normal        "#[fg=$sapphire,bold,bg=$green] #[bg=$green,fg=$crust,bold]Command#[bg=none,fg=$green]"
        mode_tmux          "#[fg=$sapphire,bold,bg=$mauve] #[bg=$mauve,fg=$crust,bold]{name}#[bg=none,fg=$mauve]"
        mode_pane          "#[fg=$sapphire,bold,bg=$teal] #[bg=$teal,fg=$crust,bold]{name}#[bg=none,fg=$teal]"
        mode_tab           "#[fg=$sapphire,bold,bg=$teal] #[bg=$teal,fg=$crust,bold]{name}#[bg=none,fg=$teal]"
        mode_scroll        "#[fg=$sapphire,bold,bg=$flamingo] #[bg=$flamingo,fg=$crust,bold]{name}#[bg=none,fg=$flamingo]"
        mode_enter_search  "#[fg=$sapphire,bold,bg=$flamingo] #[bg=$flamingo,fg=$crust,bold]{name}#[bg=$surfaco,fg=$flamingo]"
        mode_search        "#[fg=$sapphire,bold,bg=$flamingo] #[bg=$flamingo,fg=$crust,bold]{name}#[bg=$surfac0,fg=$flamingo]"
        mode_resize        "#[fg=$sapphire,bold,bg=$yellow] #[bg=$yellow,fg=$crust,bold]{name}#[bg=$surfac0,fg=$yellow]"
        mode_rename_tab    "#[fg=$sapphire,bold,bg=$yellow] #[bg=$yellow,fg=$crust,bold]{name}#[bg=none,fg=$yellow]"
        mode_rename_pane   "#[fg=$sapphire,bold,bg=$yellow] #[bg=$yellow,fg=$crust,bold]{name}#[bg=none,fg=$yellow]"
        mode_move          "#[fg=$sapphire,bold,bg=$yellow] #[bg=$yellow,fg=$crust,bold]{name}#[bg=none,fg=$yellow]"
        mode_session       "#[fg=$sapphire,bold,bg=$pink] #[bg=$pink,fg=$crust,bold]{name}#[bg=none,fg=$pink]"
        mode_prompt        "#[fg=$sapphire,bold,bg=$pink] #[bg=$pink,fg=$crust,bold]{name}#[bg=none,fg=$pink]"

        tab_normal              "#[bg=none,fg=$text]#[bg=$text,fg=$crust,bold]{index} #[bg=$surface0,fg=$text,bold] {name}{floating_indicator}#[bg=none,fg=$surface0]"
        tab_active              "#[bg=none,fg=$peach]#[bg=$peach,fg=$crust,bold]{index} #[bg=$surface1,fg=$peach,bold] {name}{floating_indicator}#[bg=none,fg=$surface1]"
        tab_separator           "#[bg=none] "

        tab_floating_indicator   " 󰹙 "

        notification_format_unread "#[bg=surface0,fg=$yellow]#[bg=$yellow,fg=$crust] #[bg=$surface1,fg=$yellow] {message}#[bg=none,fg=$yellow]"
        notification_format_no_notifications ""
        notification_show_interval "10"

        datetime          "{format}"
        datetime_format   "%Y-%m-%d 󰅐 %H:%M:%S"
        datetime_timezone "Europe/Berlin"
    }

    zellij_forgot location="https://github.com/karimould/zellij-forgot/releases/download/0.4.1/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "true"
    }
    zjquit location="https://github.com/cristiand391/zj-quit/releases/download/0.3.1/zj-quit.wasm" {
        confirm_key "y"
        cancel_key "Esc"
    }
}

// default: https://github.com/zellij-org/zellij/blob/main/zellij-utils/assets/config/default.kdl
keybinds {
    locked clear-defaults=true {
        bind "Ctrl g" { SwitchToMode "Normal"; }
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }
    normal clear-defaults=true {
        bind "Enter" "Esc" { SwitchToMode "Locked"; }
        bind "Ctrl g" "g" {
            Write 7; // 7 = ^G
            SwitchToMode "Locked";
        }

        // Mode switches
        bind "p" { SwitchToMode "Pane"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "s" { SwitchToMode "Scroll"; }
        bind "o" { SwitchToMode "Session"; }
        bind "t" { SwitchToMode "Tab"; }
        bind "h" { SwitchToMode "Move"; }
        bind "Ctrl b" "b" { SwitchToMode "Tmux"; }

        // Direct actions
        bind "Left" { MoveFocusOrTab "Left"; }
        bind "Right" { MoveFocusOrTab "Right"; }
        bind "Down" { MoveFocus "Down"; }
        bind "Up" { MoveFocus "Up"; }
        bind "=" "Alt +" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "[" { PreviousSwapLayout; }
        bind "]" { NextSwapLayout; }
        bind "y" "Alt c" { Copy; }
        bind "n" { NewPane; }
        bind "x" { CloseFocus; }
        bind "q" { LaunchOrFocusPlugin "zjquit" { floating true; }; SwitchToMode "locked"; }
        bind "?" { LaunchOrFocusPlugin "zellij_forgot" { floating true; }; SwitchToMode "locked"; }
    }

    // i think i found a bug of sorts in zellij,
    // because i need to specify these two explicitly
    // and can't just lump them into a shared mode somehow
    // i think it has to do with clear-defaults, but until
    // i can investigate further, i'll just hack it together
    locked {
        bind "Super c" { Copy; }

        // tabs
        /*bind "Super t" { NewTab; }
        bind "Super Shift Left" { GoToPreviousTab; }
        bind "Super Shift Right" { GoToNextTab; }
        bind "Super 1" { GoToTab 1; }
        bind "Super 2" { GoToTab 2; }
        bind "Super 3" { GoToTab 3; }
        bind "Super 4" { GoToTab 4; }
        bind "Super 5" { GoToTab 5; }
        bind "Super 6" { GoToTab 6; }
        bind "Super 7" { GoToTab 7; }
        bind "Super 8" { GoToTab 8; }
        bind "Super 9" { GoToTab 9; }

        // panes
        bind "Super Alt Left" { MoveFocus "Left"; }
        bind "Super Alt Right" { MoveFocus "Right"; }
        bind "Super Alt Down" { MoveFocus "Down"; }
        bind "Super Alt Up" { MoveFocus "Up"; }
        bind "Super d" { NewPane "Right"; }
        bind "Super Shift d" { NewPane "Down"; }

        bind "Super w" { CloseFocus; }*/
    }
    normal {
        bind "Super c" { Copy; }

        // tabs
        /*bind "Super t" { NewTab; }
        bind "Super Shift Left" { GoToPreviousTab; }
        bind "Super Shift Right" { GoToNextTab; }
        bind "Super 1" { GoToTab 1; }
        bind "Super 2" { GoToTab 2; }
        bind "Super 3" { GoToTab 3; }
        bind "Super 4" { GoToTab 4; }
        bind "Super 5" { GoToTab 5; }
        bind "Super 6" { GoToTab 6; }
        bind "Super 7" { GoToTab 7; }
        bind "Super 8" { GoToTab 8; }
        bind "Super 9" { GoToTab 9; }

        // panes
        bind "Super Alt Left" { MoveFocus "Left"; }
        bind "Super Alt Right" { MoveFocus "Right"; }
        bind "Super Alt Down" { MoveFocus "Down"; }
        bind "Super Alt Up" { MoveFocus "Up"; }
        bind "Super d" { NewPane "Right"; }
        bind "Super Shift d" { NewPane "Down"; }

        bind "Super w" { CloseFocus; }*/
    }
    shared {
        bind "Super c" { Copy; }

        // tabs
        /*bind "Super t" { NewTab; }
        bind "Super Shift Left" { GoToPreviousTab; }
        bind "Super Shift Right" { GoToNextTab; }
        bind "Super 1" { GoToTab 1; }
        bind "Super 2" { GoToTab 2; }
        bind "Super 3" { GoToTab 3  ; }
        bind "Super 4" { GoToTab 4; }
        bind "Super 5" { GoToTab 5; }
        bind "Super 6" { GoToTab 6; }
        bind "Super 7" { GoToTab 7; }
        bind "Super 8" { GoToTab 8; }
        bind "Super 9" { GoToTab 9; }

        // panes
        bind "Super Alt Left" { MoveFocus "Left"; }
        bind "Super Alt Right" { MoveFocus "Right"; }
        bind "Super Alt Down" { MoveFocus "Down"; }
        bind "Super Alt Up" { MoveFocus "Up"; }
        bind "Super d" { NewPane "Right"; }
        bind "Super Shift d" { NewPane "Down"; }

        bind "Super w" { CloseFocus; }*/
    }

    shared_except "locked" {
        bind "Enter" "Esc" { SwitchToMode "Locked"; }
        bind "y" "Alt c" { Copy; }
    }
    shared_except "pane" "locked" {
        bind "Ctrl p" { SwitchToMode "Pane"; }
    }
    shared_except "resize" "locked" {
        bind "Ctrl n" { SwitchToMode "Resize"; }
    }
    shared_except "scroll" "locked" {
        bind "Ctrl s" { SwitchToMode "Scroll"; }
    }
    shared_except "session" "locked" {
        bind "Ctrl o" { SwitchToMode "Session"; }
    }
    shared_except "tab" "locked" {
        bind "Ctrl t" { SwitchToMode "Tab"; }
    }
    shared_except "move" "locked" {
        bind "Ctrl h" { SwitchToMode "Move"; }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }
    pane {
        bind "n" { NewPane; SwitchToMode "Locked"; }
        bind "d" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "r" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Locked"; }
    }
    tab {
        bind "n" { NewTab; SwitchToMode "Locked"; }
        bind "x" { CloseTab; SwitchToMode "Locked"; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Locked"; }
        bind "b" { BreakPane; SwitchToMode "Locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "Locked"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Locked"; }
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }
    }
    scroll {
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
    }
    shared_among "scroll" "search" {
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" { SwitchToMode "Locked"; }
    }
    session {
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Locked"
        }
    }
    tmux {
        bind "[" { SwitchToMode "Scroll"; }
        bind "Ctrl b" { Write 2; SwitchToMode "Locked"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "%" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "c" { NewTab; SwitchToMode "Locked"; }
        bind "," { SwitchToMode "RenameTab"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "n" { GoToNextTab; SwitchToMode "Locked"; }
        bind "Left" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "Down" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "Up" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "h" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "l" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "j" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "k" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "o" { FocusNextPane; }
        bind "d" { Detach; }
        bind "Space" { NextSwapLayout; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
    }
}
 
// mouse_mode false

// mirror_session true
// scroll_buffer_size 10000
 
// Provide a command to execute when copying text. The text will be piped to
// the stdin of the program to perform the copy. This can be used with
// terminal emulators which do not support the OSC 52 ANSI control sequence
// that will be used by default if this option is not set.
// Examples:
//
// copy_command "xclip -selection clipboard" // x11
// copy_command "wl-copy"                    // wayland
// copy_command "pbcopy"                     // osx
// 
// copy_command "pbcopy"
 
// Choose the destination for copied text
// Allows using the primary selection buffer (on x11/wayland) instead of the system clipboard.
// Does not apply when using copy_command.
// Options:
//   - system (default)
//   - primary
// 
// copy_clipboard "primary"
 
// Enable automatic copying (and clearing) of selection when releasing mouse
// Default: true
// 
copy_on_select false
 
// Path to the default editor to use to edit pane scrollbuffer
// Default: $EDITOR or $VISUAL
// scrollback_editor "/usr/bin/vim"
 
// Toggle between having Zellij lay out panes according to a predefined set of layouts whenever possible
// Options:
//   - true (default)
//   - false
// 
// auto_layout false

// quit zellij if the surrounding terminal is quit as well
// this may need to be changed again in the future once i move to another terminal emulator
// but for now, this is just leaving way too many dangling zj sessions
// i might be able to make a cronjob that just kills zj sessions without a running program every once in a while tho
on_force_close "quit"
 
session_serialization false

simplified_ui false
 
// Enable or disable writing of session metadata to disk (if disabled, other sessions might not know
// metadata info on this session)
// (Requires restart)
// Default: false
// 
// disable_session_metadata false
 
support_kitty_keyboard_protocol true
