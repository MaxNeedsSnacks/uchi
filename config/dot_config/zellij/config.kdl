theme_light "rose-pine-dawn"
theme_dark "rose-pine-moon"

default_layout "compact"
default_mode "locked"
ui { pane_frames { rounded_corners true; }; }

copy_on_select false
session_serialization false
support_kitty_keyboard_protocol true
// kill sessions when the terminal closes, otherwise they pile up
on_force_close "quit"

plugins {
    zellij_forgot location="https://github.com/karimould/zellij-forgot/releases/download/0.4.2/zellij_forgot.wasm" {
        "LOAD_ZELLIJ_BINDINGS" "true"
    }
}

keybinds {
    locked clear-defaults=true {
        bind "Ctrl g" { SwitchToMode "Normal"; }
        bind "Ctrl b" { SwitchToMode "Tmux"; }
        bind "Super c" { Copy; }
    }
    normal clear-defaults=true {
        bind "Enter" "Esc" { SwitchToMode "Locked"; }
        bind "Ctrl g" "g" { Write 7; SwitchToMode "Locked"; } // pass ^G through
        bind "Super c" "y" "Alt c" { Copy; }

        bind "p" { SwitchToMode "Pane"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "s" { SwitchToMode "Scroll"; }
        bind "o" { SwitchToMode "Session"; }
        bind "t" { SwitchToMode "Tab"; }
        bind "h" { SwitchToMode "Move"; }
        bind "Ctrl b" "b" { SwitchToMode "Tmux"; }

        bind "Left" { MoveFocusOrTab "Left"; }
        bind "Right" { MoveFocusOrTab "Right"; }
        bind "Down" { MoveFocus "Down"; }
        bind "Up" { MoveFocus "Up"; }
        bind "=" "Alt +" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "[" { PreviousSwapLayout; }
        bind "]" { NextSwapLayout; }
        bind "n" { NewPane; }
        bind "x" { CloseFocus; }
        bind "q" { Quit; }
        bind "?" { LaunchOrFocusPlugin "zellij_forgot" { floating true; }; SwitchToMode "Locked"; }
    }

    shared {
        bind "Super c" { Copy; }
    }
    shared_except "locked" {
        bind "Enter" "Esc" { SwitchToMode "Locked"; }
        bind "y" "Alt c" { Copy; }
    }
    shared_except "pane" "locked"    { bind "Ctrl p" { SwitchToMode "Pane"; }; }
    shared_except "resize" "locked"  { bind "Ctrl n" { SwitchToMode "Resize"; }; }
    shared_except "scroll" "locked"  { bind "Ctrl s" { SwitchToMode "Scroll"; }; }
    shared_except "session" "locked" { bind "Ctrl o" { SwitchToMode "Session"; }; }
    shared_except "tab" "locked"     { bind "Ctrl t" { SwitchToMode "Tab"; }; }
    shared_except "move" "locked"    { bind "Ctrl h" { SwitchToMode "Move"; }; }
    shared_except "tmux" "locked"    { bind "Ctrl b" { SwitchToMode "Tmux"; }; }

    pane {
        bind "n" { NewPane; SwitchToMode "Locked"; }
        bind "d" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "r" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Locked"; }
    }
    tab {
        bind "n" { NewTab; SwitchToMode "Locked"; }
        bind "x" { CloseTab; SwitchToMode "Locked"; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Locked"; }
        bind "b" { BreakPane; SwitchToMode "Locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "Locked"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Locked"; }
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }
    }
    scroll {
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
    }
    shared_among "scroll" "search" {
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Locked"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" { SwitchToMode "Locked"; }
    }
    session {
        bind "w" { LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "Locked"; }
        bind "c" { LaunchOrFocusPlugin "configuration" { floating true; move_to_focused_tab true; }; SwitchToMode "Locked"; }
        bind "p" { LaunchOrFocusPlugin "plugin-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "Locked"; }
    }
    tmux {
        bind "[" { SwitchToMode "Scroll"; }
        bind "Ctrl b" { Write 2; SwitchToMode "Locked"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "%" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "c" { NewTab; SwitchToMode "Locked"; }
        bind "," { SwitchToMode "RenameTab"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "n" { GoToNextTab; SwitchToMode "Locked"; }
        bind "Left" "h" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "Right" "l" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "Down" "j" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "Up" "k" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "o" { FocusNextPane; }
        bind "d" { Detach; }
        bind "Space" { NextSwapLayout; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
    }
}
