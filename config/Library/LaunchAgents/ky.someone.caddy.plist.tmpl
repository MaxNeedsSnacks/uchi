{{ if eq .chezmoi.hostname "stargazer" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ky.someone.caddy</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/bin/caddy</string>
		<string>run</string>
		<string>--config</string>
		<string>/data/docker/Caddyfile</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/caddy/caddy.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/.local/state/caddy/caddy.log</string>
</dict>
</plist>
{{ end -}}
