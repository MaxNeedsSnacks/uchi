{{ if eq .chezmoi.hostname "stargazer" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ky.someone.jellyfin</string>
	<key>ProgramArguments</key>
	<array>
    	<string>/Applications/Jellyfin.app/Contents/MacOS/jellyfin</string>
        <string>--datadir</string>   <string>/data/srv/jellyfin/data</string>
        <string>--configdir</string> <string>/data/srv/jellyfin/config</string>
        <string>--cachedir</string>  <string>/data/srv/jellyfin/cache</string>
        <string>--logdir</string>    <string>/data/srv/jellyfin/log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
    <dict>
    <key>PathState</key>
    <dict>
        <key>/data/.mounted</key>
        <true/>
    </dict>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/data/srv/jellyfin/log/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/data/srv/jellyfin/log/launchd.err</string>
</dict>
</plist>
{{ end -}}
