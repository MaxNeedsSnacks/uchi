#!/bin/sh

# installs packages from the Brewfile as necessary
# updates when the file changes
set -eu

{{ if eq .chezmoi.os "darwin" -}}

command -v brew >/dev/null 2>&1 || eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle install --file=- <<'BREWEOF'
{{ includeTemplate "dot_config/homebrew/Brewfile.tmpl" . }}
BREWEOF

{{- end }}
