#!/bin/sh

# installs packages from the Brewfile as necessary. reruns if below changes
# Brewfile hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
set -eu

{{ if eq .chezmoi.os "darwin" -}}

command -v brew >/dev/null 2>&1 || eval "$(/opt/homebrew/bin/brew shellenv)"

brew bundle install --global

{{- end }}
