#!/bin/sh

# installs packages from the pkglist as necessary
# updates when the file changes
set -eu

{{ if eq .chezmoi.os "linux" -}}
{{- /* regexReplaceAll takes the input as its MIDDLE arg, so no piping here */ -}}
{{ $pkgs := includeTemplate "dot_config/paru/pkglist.txt.tmpl" . -}}
{{ $pkgs = regexReplaceAll `(?m)\s*#.*$` $pkgs "" -}}
{{ $pkgs = regexReplaceAll `(?m)^\s*$\n?` $pkgs "" -}}
{{ if $pkgs -}}

paru -S --needed - <<'PKGEOF'
{{ $pkgs -}}
PKGEOF

{{ end -}}
{{ end }}
