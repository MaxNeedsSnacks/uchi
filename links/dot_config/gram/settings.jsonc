// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "file_types": {
    "html": ["*.html"],
    "javascriptreact": ["*.js"],
    "css": ["*.css"],
    "XML": ["*.svg"],
    "markdown": ["*.kubedoc"],
  },
  "node": {
    "allow_npm_install": true,
    "allow_prettier_download": false,
    "allow_binary_download": false,
  },
  "languages": {
    "YAML": {
      "tab_size": 4,
    },
  },
  "ssh_connections": [
    {
      "host": "stargazer",
      "args": [],
      "projects": [
        {
          "paths": ["/data/docker"],
        },
      ],
    },
    {
      "host": "hetzner",
      "args": [],
      "projects": [
        {
          "paths": ["/opt"],
        },
      ],
    },
  ],
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "relative_line_numbers": "enabled",
  "vim_mode": true,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 15.0,
  },
  "base_keymap": "JetBrains",
  "buffer_font_fallbacks": [
    "Fira Code",
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace",
  ],
  "buffer_font_features": {
    "calt": true,
  },
  "load_direnv": "shell_hook",
  "format_on_save": "on",
  "lsp": {
    "lemminx": {
      "binary": {
        "allow_binary_download": false,
      },
      "enable_lsp_tasks": true,
    },
    "mdx-analyzer": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "vscode-css-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "astro-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "eslint": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "vtsls": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "tailwindcss-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "rust-analyzer": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "bash-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "yaml-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "package-version-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "ruff": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "basedpyright": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "json-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "zls": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "nil": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
  },
  "inlay_hints": {
    "show_background": true,
    "enabled": true,
  },
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "icon_theme": "Gram (Default)",
  "ui_font_size": 15.0,
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine Moon",
  },
}
