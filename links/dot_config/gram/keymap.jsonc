// Gram keymap
//
// For information on binding keys, see the Gram
// documentation: gram://docs/key-bindings
//
// To see the default key bindings run `gram: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl ctrl": "command_palette::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd cmd": "command_palette::Toggle",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
    },
  },
  {
    "context": "VimControl && !menu",
      "bindings": {
      "m m": [
        "vim::Matching",
        {
          "match_quotes": true
        }
      ]
    }
  }
]
